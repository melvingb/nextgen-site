# Public repository metadata (optional; raises unauthenticated API limits)
GITHUB_TOKEN=

# GitHub OAuth login for /admin
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
ADMIN_GITHUB_LOGIN=melvingb

# GitHub App publishing for /admin
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Recommended on Vercel: base64 of the downloaded .pem file (single line)
GITHUB_APP_PRIVATE_KEY_BASE64=
# Raw PEM fallback (multiline or escaped \\n)
GITHUB_APP_PRIVATE_KEY=

# Optional publishing overrides
GITHUB_CONTENT_REPOSITORY=melvingb/nextgen-site
GITHUB_CONTENT_BRANCH=

# Vercel Blob media storage
# New Vercel project connections use OIDC automatically.
# BLOB_STORE_ID and VERCEL_OIDC_TOKEN are injected by Vercel when the store is connected.
# For local development: run "vercel link" and "vercel env pull".
